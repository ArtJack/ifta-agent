# IFTA — Oracle Linux production environment.
#
# Copy to deploy/oracle/.env on the box and fill in. This file is read by
# docker compose; it is NOT committed (deploy/oracle/.env is gitignored).
#
#   install -m 600 deploy/oracle/.env.example deploy/oracle/.env
#
# Keep the mode at 0600 — it holds the database password, the Anthropic key,
# and the R2 credentials that can read every customer backup.

# --- storage ---------------------------------------------------------------
# Where PII bind mounts and Postgres data live on the host. install.sh creates
# these with owner 10001 (the container's `ifta` user).
IFTA_STATE_DIR=/var/lib/ifta
# Host directory for local snapshot copies before they go to R2.
IFTA_BACKUP_HOST_DIR=/var/lib/ifta/backups

# --- database --------------------------------------------------------------
# Generate once and never rotate casually — the Postgres volume is initialised
# with it:  openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_STRING

# --- public surface --------------------------------------------------------
IFTA_WEB_PUBLIC_BASE_URL=https://ifta-api.artjeck.com
IFTA_WEB_CORS_ORIGINS=https://artjeck.com,https://www.artjeck.com
IFTA_WEB_ADMIN_BCC=eugene@artjeck.com
IFTA_WEB_SUBMIT_RATE_LIMIT=3/hour
IFTA_WEB_MAX_FILE_MB=10
# Shared secret for the operator/backend endpoints. openssl rand -hex 32
IFTA_WEB_BACKEND_KEY=

# --- Cloudflare tunnel -----------------------------------------------------
# Zero Trust dashboard -> Networks -> Tunnels -> your tunnel -> install token.
# Route ifta-api.artjeck.com to http://web:8000 in the tunnel's Public Hostname
# tab (the container reaches the app over the compose network by service name).
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_TUNNEL_TOKEN

# --- third-party services --------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-REPLACE
RESEND_API_KEY=re_REPLACE
RESEND_FROM_EMAIL=ArtJeck IFTA <ifta@artjeck.com>
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET

# --- Telegram (optional) ---------------------------------------------------
# Leave TELEGRAM_BOT_TOKEN empty until you have the real token; the bot only
# starts under the `telegram` compose profile, so an empty value is harmless.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_ADMIN_CHAT_ID=

# --- backups: Cloudflare R2 ------------------------------------------------
# Set ALL FOUR or NONE. Half-configured raises at backup time rather than
# silently keeping snapshots on the box (see src/ifta/backup_remote.py).
# R2 dashboard -> Manage API tokens -> Create token (Object Read & Write,
# scoped to this bucket only). The bucket MUST stay private: these archives
# are unencrypted customer PII.
IFTA_BACKUP_R2_BUCKET=ifta-backups
IFTA_BACKUP_R2_ENDPOINT=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
IFTA_BACKUP_R2_ACCESS_KEY_ID=REPLACE
IFTA_BACKUP_R2_SECRET_ACCESS_KEY=REPLACE
IFTA_BACKUP_R2_PREFIX=snapshots
# Snapshots retained on each side. Each run uploads one and deletes the oldest
# beyond this count, so the bucket never grows without bound.
IFTA_BACKUP_KEEP=3

# --- misc ------------------------------------------------------------------
TZ=America/Chicago
